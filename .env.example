# ---- Runtime ----
NODE_ENV=development
PORT=3030
APP_URL=http://localhost:5173            # public URL of the web app (CORS / trusted origin / mail links)
API_URL=http://localhost:3030            # public URL of the API (Better Auth baseURL)
LOG_LEVEL=info

# ---- Database (LiteLLM Postgres host, own schema) ----
DATABASE_URL=postgres://api_selfservice:api_selfservice@localhost:5433/litellm
DB_SCHEMA=api_selfservice

# ---- Better Auth ----
AUTH_SECRET=change-me-32-chars-minimum-random-string

# ---- Keycloak ----
KEYCLOAK_ISSUER=https://keycloak.safeaiplus.de/realms/api-selfservice-dev
KEYCLOAK_CLIENT_ID=api-selfservice
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_GROUP=LiteLLMAdmin
KEYCLOAK_ADMIN_CLIENT_ID=                  # optional: service-account client with view-users for the Austrittsprozess
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_GROUPS_CLAIM=groups
KEYCLOAK_AFFILIATION_CLAIM=eduPersonAffiliation
KEYCLOAK_AFFILIATION_VALID=member,staff
# Empty KEYCLOAK_AFFILIATION_VALID disables the affiliation check.

# ---- Keycloak setup script only (scripts/keycloak-setup.mts, not read by the app) ----
KC_ADMIN_USER=                            # admin of the master realm
KC_ADMIN_PASS=
KC_ADMIN_REALM=master
KC_TEST_USER_PASS=                        # password for admin-test/user-test/ext-test; set = reset on every run, empty = generated once

# ---- LiteLLM ----
LITELLM_BASE_URL=https://litellm.safeaiplus.de
LITELLM_API_KEY=
LITELLM_MODE=http                         # http | mock  (mock = no LiteLLM needed, synthetic data)

# ---- Mail (Nodemailer) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="API-Selfservice <noreply@localhost>"
ADMIN_NOTIFY_EMAILS=                      # comma separated, fallback: all admins

# ---- Business rules ----
KEY_LIFETIME_DAYS=182
DELETION_GRACE_DAYS=365
BUDGET_WARN_THRESHOLD=0.8
JOBS_ENABLED=true
LOG_INGEST_CRON=*/5 * * * *
AFFILIATION_CHECK_CRON=0 3 * * *

# ---- Development only (refused when NODE_ENV=production) ----
DEV_LOGIN_ENABLED=false                   # enables POST /api/auth/dev-login for local dev and E2E

# ---- Debugging ----
IMPERSONATION_ENABLED=false               # admins may act as another user (Users / roles -> Impersonate); audited
API_DOCS_ADMIN_ONLY=false                 # /api/docs and /api/openapi.json only for signed-in admins (always on in production)
