# Test environment against the local Docker stack (docker compose --profile litellm up -d).
# Loaded by the Playwright configs (e2e/test-env.ts); process.env wins, then this file, then .env.
# Only local, non-secret values: never point this file at a shared LiteLLM.

# own schema so test data never mixes with local dev data
DB_SCHEMA=api_selfservice_e2e_local

# mock by default; the live config switches to http against the local proxy below
LITELLM_MODE=mock
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-master

# mail goes to Mailpit only
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAILPIT_URL=http://localhost:8025

DEV_LOGIN_ENABLED=true
