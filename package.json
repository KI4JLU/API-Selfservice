{
  "name": "api-selfservice",
  "private": true,
  "version": "0.8.1",
  "description": "Self-service portal for an existing LiteLLM proxy: Keycloak SSO, roles, cost centers with approval workflow, budgets, API key self-service, request logs, reports and email notifications.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:dev": "node scripts/setup.mts",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @api-selfservice/api dev",
    "dev:web": "pnpm --filter @api-selfservice/web dev",
    "litellm:up": "docker compose --profile litellm up -d --wait litellm",
    "litellm:down": "docker compose --profile litellm stop litellm litellm-db",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:live": "playwright test -c e2e/playwright.live.config.ts",
    "test:e2e:local": "E2E_ENV_FILE=.env.test playwright test -c e2e/playwright.live.config.ts",
    "db:generate": "pnpm --filter @api-selfservice/db generate",
    "db:migrate": "pnpm --filter @api-selfservice/db migrate",
    "db:seed": "pnpm --filter @api-selfservice/db seed",
    "keycloak:setup": "node scripts/keycloak-setup.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  }
}
